import tkinter as tk
import random

# Choices
CHOICES = ["Rock", "Paper", "Scissors"]

# Score
user_score = 0
comp_score = 0

# Winner decide function
def decide_winner(user, comp):
    global user_score, comp_score
    if user == comp:
        result.set("It's a Tie!")
    elif (user == "Rock" and comp == "Scissors") or \
         (user == "Paper" and comp == "Rock") or \
         (user == "Scissors" and comp == "Paper"):
        user_score += 1
        result.set("You Win 🎉")
    else:
        comp_score += 1
        result.set("Computer Wins 😅")
    
    update_score()
    choice_label.set(f"You: {user} | Computer: {comp}")

# Update scoreboard
def update_score():
    score_label.set(f"Score - You: {user_score} | Computer: {comp_score}")

# User choice
def play(choice):
    comp_choice = random.choice(CHOICES)
    decide_winner(choice, comp_choice)

# Reset game
def reset_game():
    global user_score, comp_score
    user_score = 0
    comp_score = 0
    update_score()
    choice_label.set("Make your move...")
    result.set("Result will appear here!")

# Tkinter GUI
root = tk.Tk()
root.title("Rock Paper Scissors Game")
root.geometry("400x400")
root.config(bg="#222")

# Labels
title = tk.Label(root, text="Rock Paper Scissors", font=("Arial", 18, "bold"), fg="white", bg="#222")
title.pack(pady=10)

choice_label = tk.StringVar()
choice_label.set("Make your move...")
choice_display = tk.Label(root, textvariable=choice_label, font=("Arial", 12), fg="yellow", bg="#222")
choice_display.pack(pady=10)

result = tk.StringVar()
result.set("Result will appear here!")
result_display = tk.Label(root, textvariable=result, font=("Arial", 14, "bold"), fg="cyan", bg="#222")
result_display.pack(pady=10)

score_label = tk.StringVar()
score_label.set("Score - You: 0 | Computer: 0")
score_display = tk.Label(root, textvariable=score_label, font=("Arial", 12), fg="white", bg="#222")
score_display.pack(pady=10)

# Buttons
button_frame = tk.Frame(root, bg="#222")
button_frame.pack(pady=15)

rock_btn = tk.Button(button_frame, text="🪨 Rock", width=10, command=lambda: play("Rock"))
rock_btn.grid(row=0, column=0, padx=10)

paper_btn = tk.Button(button_frame, text="📄 Paper", width=10, command=lambda: play("Paper"))
paper_btn.grid(row=0, column=1, padx=10)

scissors_btn = tk.Button(button_frame, text="✂ Scissors", width=10, command=lambda: play("Scissors"))
scissors_btn.grid(row=0, column=2, padx=10)

reset_btn = tk.Button(root, text="🔄 Reset Game", command=reset_game, bg="red", fg="white")
reset_btn.pack(pady=20)

root.mainloop()